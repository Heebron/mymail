mbox_locks = fcntl

imap_executable = /usr/local/libexec/dovecot/imap
pop3_executable = /usr/local/libexec/dovecot/pop3

auth = default
auth_mechanisms = plain

auth_userdb = passwd
auth_passdb = passwd

auth_executable = /usr/local/libexec/dovecot/dovecot-auth
auth_user = root
auth_count = 5
auth_verbose = yes


