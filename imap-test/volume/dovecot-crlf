+                       stream->istream.start_offset +
+                       stream->istream.v_offset);
+               } else {
+                       ret = read(stream->fd,
+                       stream->w_buffer + stream->pos, size);
+               }
                 if (ret == 0) {
                         /* EOF */
                         stream->istream.stream_errno = 0;
@@ -228,7 +236,7 @@
                 stream->istream.stream_errno = EOVERFLOW;
                 ret = -1;
         } else {
-               ret = lseek(stream->fd, (off_t)real_offset, SEEK_SET);
