-                                                    " OK Logged in.", 
NULL));
        }
 }
 
@@ -125,8 +122,10 @@
 int main(int argc __attr_unused__, char *argv[], char *envp[])
 {
 #ifdef DEBUG
-       if (getenv("LOGIN_TAG") != NULL)
+       if (getenv("LOGGED_IN") != NULL) {
                fd_debug_verify_leaks(3, 1024);
+               putenv("DISABLE_ALARMHUP=1"); /* annoying when debugging 
*/
