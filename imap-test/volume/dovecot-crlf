+	auth->digest =3D p_strndup(auth->pool, tmp, 32);
+
+	passdb->lookup_credentials(auth_request, PASSDB_CREDENTIALS_PLAINTEXT,
+				   apop_credentials_callback);
+
+	return TRUE;
+}
