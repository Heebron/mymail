# Send only the Go sources required to build the server image.
#
# IMPORTANT: This file uses an allowlist pattern. Every new Go package
# must be explicitly listed below, or it will be excluded from the
# Docker build and compilation will fail.
*
!go.mod
!go.sum
!cmd/
!cmd/mymail/
!cmd/mymail/**
!auth/
!auth/**
!config/
!config/**
!dkim/
!dkim/**
!health/
!health/**
!imap/
!imap/**
!logging/
!logging/**
!maildir/
!maildir/**
!plugins/
!plugins/**
!smtp/
!smtp/**
!split/
